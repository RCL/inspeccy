# Verify bank-elision sentinel for an all-zero bank. psg_silent.sna has code
# only in bank 2; banks 5/0/1/3/4/6/7 are all zero → each emits "<N>:zeros".

description    = all-zero RAM banks are elided as "<N>:zeros"
sna            = data/sna/psg_silent.sna
seconds        = 0.1

expect_exit             = 6
expect_dump_field_eq    = ram.bank_5=5:zeros
expect_dump_field_eq    = ram.bank_0=0:zeros
expect_dump_field_eq    = ram.bank_1=1:zeros
expect_dump_field_eq    = ram.bank_7=7:zeros
