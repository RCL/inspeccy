# Fill all 768 attributes with $38 (paper white, ink black). With pixels all
# zero, the entire paper area renders as solid white. uniform_white.sna does
# the fill via LDIR.

description    = LDIR-fill of attrs to $38 yields a solid-white paper area
sna            = data/sna/uniform_white.sna
seconds        = 0.1

expect_exit              = 6
expect_status_field_eq   = vram.attr_writes_bank5=768
expect_status_field_eq   = vram.attrs_all_equal=true
expect_status_field_eq   = vram.first_attr_byte=$38
expect_status_field_eq   = vram.distinct_attrs=1
expect_status_field_eq   = vram.uniform_screen=true
